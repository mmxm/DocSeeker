{
  "name": "docseeker-tests",
  "version": "9.1",
  "description": "DocSeeker - Tests Automatiques UI & Moteur Hors-Ligne",
  "private": true,
  "type": "module",
  "scripts": {
    "test:version": "node tests/test_version_consistency.mjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "build:milkdown": "npx esbuild frontend/src-milkdown/crepe-entry.js --bundle --minify --format=iife --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.ttf=dataurl --loader:.svg=dataurl --loader:.png=dataurl --outfile=frontend/vendor/milkdown.js",
    "bump": "bash scripts/bump_version.sh"
  },
  "devDependencies": {
    "@milkdown/core": "^7.22.2",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@playwright/test": "^1.50.0"
  }
}
