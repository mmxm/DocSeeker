# ==============================================================================
# DocSeeker v2.0 - Variables d'environnement (Rust & Sécurité Native)
# ==============================================================================

# Version de l'application
DOCSEEKER_VERSION=2.0.0

# Identifiant Utilisateur et Groupe (DSM Synology / Linux)
PUID=1000
PGID=1000

# Port d'écoute sur la machine hôte (défaut : 8080)
PORT=8080
HOST=0.0.0.0

# Authentification Native Sécurisée (Compte Unique Administrateur)
# Mot de passe par défaut pour la première initialisation (haché avec Argon2id en base)
ADMIN_PASSWORD=admin1234

# Durée de validité des sessions (en jours)
SESSION_DURATION_DAYS=30

# Taille maximale de téléversement (en Mo)
MAX_UPLOAD_SIZE_MB=2048
