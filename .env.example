# ==============================================================================
# DocSeeker - Variables d'environnement de Production
# ==============================================================================

# Version de l'application (permet d'invalider le cache de build Docker sur le NAS)
DOCSEEKER_VERSION=1.0.0

# Identifiant Utilisateur et Groupe (DSM Synology)
# Sur Synology DSM, le premier utilisateur a généralement l'UID 1026 et le groupe 100 (users).
# Laissez 1026 et 100 par défaut, ou vérifiez avec 'id' en SSH sur le NAS si besoin.
PUID=1026
PGID=100

# Nom de domaine public (Optionnel)
# - Laisser vide pour un accès direct local par IP ou pour utiliser le Reverse Proxy Synology DSM
# - Renseigner uniquement si vous voulez que Caddy gère lui-même un nom de domaine avec SSL (ex: docseeker.mondomaine.fr)
DOMAIN=

# Ports d'écoute sur la machine hôte
# NOTE POUR SYNOLOGY NAS : Les ports 80 et 443 étant réservés par DSM,
# nous utilisons 8080 et 8443 par défaut. Sur un serveur dédié, vous pouvez utiliser 80 et 443.
HOST_HTTP_PORT=8080
HOST_HTTPS_PORT=8443

# Utilisateur pour l'accès sécurisé (Basic Auth)
BASIC_AUTH_USER=admin

# Hash Bcrypt du mot de passe administrateur
# Pour générer ce hash avec Docker :
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext "VotreMotDePasseRobuste"
# (Dans les fichiers .env utilisés par docker compose, doubler les $ : $$2a$$14$$... )
# Valeur par défaut ci-dessous pour mot de passe temporaire 'admin1234' - À CHANGER IMPÉRATIVEMENT :
BASIC_AUTH_PASSWORD_HASH=$$2a$$14$$6VwT0dLz82PsY3YdhM9AWelUJM1OhX2aaFd.QOq426DwdVlcTt25K

# Taille maximale de téléversement en octets (500 Mo = 524288000 octets)
MAX_UPLOAD_SIZE_BYTES=524288000
