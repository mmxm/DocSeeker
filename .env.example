# ==============================================================================
# DocFastExplorer - Variables d'environnement de Production
# ==============================================================================

# Nom de domaine public (utilisé par Caddy pour la négociation automatique du certificat SSL Let's Encrypt)
# Exemple: docfast.mon-domaine.fr (ou localhost pour un test local sans SSL public)
DOMAIN=localhost

# Utilisateur pour l'accès sécurisé (Basic Auth)
BASIC_AUTH_USER=admin

# Hash Bcrypt du mot de passe administrateur
# Pour générer ce hash avec Docker :
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext "VotreMotDePasseRobuste"
# (Dans les fichiers .env utilisés par docker compose, doubler les $ : $$2a$$14$$... )
# Valeur par défaut ci-dessous pour mot de passe temporaire 'admin1234' - À CHANGER IMPÉRATIVEMENT :
BASIC_AUTH_PASSWORD_HASH=$$2a$$14$$6VwT0dLz82PsY3YdhM9AWelUJM1OhX2aaFd.QOq426DwdVlcTt25K

# Taille maximale de téléversement en octets (150 Mo = 157286400)
MAX_UPLOAD_SIZE_BYTES=157286400
