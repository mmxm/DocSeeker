# ==============================================================================
# DocSeeker - Caddyfile (Reverse Proxy, SSL Automatique & Authentification)
# ==============================================================================

# Désactive les redirections automatiques HTTPS de Caddy car c'est le Reverse Proxy Synology
# qui gère le HTTPS et les certificats SSL en amont.
{
    auto_https off
}

:80 {
    # --------------------------------------------------------------------------
    # En-têtes HTTP de Sécurité
    # --------------------------------------------------------------------------
    header {
        # Protection contre le MIME-sniffing
        X-Content-Type-Options "nosniff"

        # Empêche le clickjacking tout en autorisant l'affichage de notre viewer interne
        X-Frame-Options "SAMEORIGIN"

        # Protection des informations de provenance (Referrer)
        Referrer-Policy "strict-origin-when-cross-origin"

        # Désactivation des fonctionnalités sensibles du navigateur inutilisées
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Masque le header d'identification du serveur Caddy
        -Server
    }

    # --------------------------------------------------------------------------
    # Limitation de la taille maximale des requêtes (gérée uniquement par Caddy)
    # Configurable directement dans docker-compose.yml via MAX_UPLOAD_SIZE (ex: 2GB, 500MB)
    # --------------------------------------------------------------------------
    request_body {
        max_size {$MAX_UPLOAD_SIZE:2GB}
    }

    # --------------------------------------------------------------------------
    # Authentification HTTP Basic Auth (Compte unique sécurisé)
    # Note: L'utilisateur et le hash bcrypt sont injectés via variables d'environnement
    # Pour générer un hash : caddy hash-password --plaintext "mon_mot_de_passe"
    # --------------------------------------------------------------------------
    basic_auth {
        {$BASIC_AUTH_USER} "{$BASIC_AUTH_PASSWORD_HASH}"
    }

    # --------------------------------------------------------------------------
    # Proxy vers l'application FastAPI
    # --------------------------------------------------------------------------
    reverse_proxy app:8000


    # --------------------------------------------------------------------------
    # Compression dynamique (Gzip / Zstandard)
    # --------------------------------------------------------------------------
    encode zstd gzip

    # --------------------------------------------------------------------------
    # Journalisation des accès
    # --------------------------------------------------------------------------
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MB
            roll_keep 5
        }
        format json
    }
}
